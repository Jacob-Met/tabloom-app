{
  "name": "tabloom",
  "version": "0.1.0",
  "description": "Split a shared bill by who had what, to the exact cent, with a PayPal Sandbox checkout per guest.",
  "license": "MIT",
  "type": "module",
  "main": "dist/src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prebuild": "node tools/prepare-receipt-ocr.mjs",
    "build": "tsc --noEmitOnError && node tools/copy-tabloom-assets.mjs",
    "start": "node dist/src/index.js",
    "demo": "node demo.mjs",
    "test": "npm run build && node --test dist/test/*.test.js test/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "@types/node": "^26.6.5",
    "@types/pngjs": "6.0.5",
    "@types/qrcode": "1.5.6",
    "jsqr": "1.4.0",
    "tesseract.js": "7.0.0",
    "typescript": "^5.9.0"
  }
}